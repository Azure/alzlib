{
  "name": "member-pd",
  "type": "Microsoft.Authorization/policyDefinitions",
  "apiVersion": "2021-06-01",
  "scope": null,
  "properties": {
    "policyType": "Custom",
    "mode": "All",
    "displayName": "PD from member",
    "description": "Declares memberParameter, which the member defaults require.",
    "metadata": {
      "version": "1.0.0",
      "category": "Test"
    },
    "parameters": {
      "memberParameter": {
        "type": "String",
        "defaultValue": "Audit",
        "metadata": {
          "displayName": "Member parameter",
          "description": "Only present in the member version."
        }
      }
    },
    "policyRule": {
      "if": {
        "field": "type",
        "equals": "Microsoft.Resources/subscriptions"
      },
      "then": {
        "effect": "deny"
      }
    }
  }
}
